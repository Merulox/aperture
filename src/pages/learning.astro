---
import AppLayout from '../layouts/AppLayout.astro';
import { homedir } from 'node:os';
import { join } from 'node:path';
import { readFile } from 'node:fs/promises';

type SkillStatus = 'active' | 'queued' | 'later' | 'complete';

type Skill = {
  priority: number;
  name: string;
  status: SkillStatus;
  why: string;
  competency: string;
  tools: string[];
  firstExercise: string;
};

type Phase = {
  id: string;
  title: string;
  objective: string;
  skills: Skill[];
};

type Curriculum = {
  title: string;
  goal: string;
  updated: string;
  source: string;
  phases: Phase[];
};

const curriculumPath = join(homedir(), 'kernel/project/LEARNING.json');
let curriculum: Curriculum | null = null;
let loadError = '';

try {
  curriculum = JSON.parse(await readFile(curriculumPath, 'utf8')) as Curriculum;
} catch (error) {
  loadError = error instanceof Error ? error.message : 'Unknown read error';
}

const skills = curriculum?.phases.flatMap((phase) => phase.skills) ?? [];
const completeCount = skills.filter((skill) => skill.status === 'complete').length;
const activeCount = skills.filter((skill) => skill.status === 'active').length;

function statusClass(status: SkillStatus): string {
  if (status === 'complete') return 'badge badge-green';
  if (status === 'active') return 'badge badge-blue';
  if (status === 'later') return 'badge badge-muted';
  return 'badge badge-yellow';
}
---
<AppLayout title="Learning" page="learning" subtitle="learning">
  {curriculum ? (
    <Fragment slot="topbar-extra">
      <span>updated {curriculum.updated}</span>
    </Fragment>
  ) : null}

  {curriculum ? (
    <>
      <section class="panel panel-wide learning-hero" aria-labelledby="learning-heading">
        <div class="learning-copy">
          <div class="label">operator curriculum</div>
          <h1 id="learning-heading">{curriculum.title}</h1>
          <p>{curriculum.goal}</p>
          <div class="learning-source">source · ~/kernel/{curriculum.source}</div>
        </div>
        <dl class="learning-vitals" aria-label="Curriculum progress">
          <div>
            <dt>skills</dt>
            <dd>{skills.length}</dd>
          </div>
          <div>
            <dt>active</dt>
            <dd class="vital-active">{activeCount}</dd>
          </div>
          <div>
            <dt>complete</dt>
            <dd class="vital-complete">{completeCount}</dd>
          </div>
        </dl>
      </section>

      <div class="learning-phases">
        {curriculum.phases.map((phase, phaseIndex) => (
          <section class="panel learning-phase" aria-labelledby={`phase-${phase.id}`}>
            <header class="learning-phase-head">
              <div class="learning-phase-index">0{phaseIndex + 1}</div>
              <div>
                <div class="label">phase</div>
                <h2 id={`phase-${phase.id}`}>{phase.title}</h2>
                <p>{phase.objective}</p>
              </div>
            </header>

            <div class="learning-skill-list">
              {phase.skills.map((skill) => (
                <details class="learning-skill" open={skill.status === 'active'}>
                  <summary>
                    <span class="skill-priority">{String(skill.priority).padStart(2, '0')}</span>
                    <span class="skill-name">{skill.name}</span>
                    <span class={statusClass(skill.status)}>{skill.status}</span>
                    <span class="skill-chevron" aria-hidden="true">▾</span>
                  </summary>
                  <div class="skill-body">
                    <div class="skill-field">
                      <span>why</span>
                      <p>{skill.why}</p>
                    </div>
                    <div class="skill-field">
                      <span>competency</span>
                      <p>{skill.competency}</p>
                    </div>
                    <div class="skill-field">
                      <span>first exercise</span>
                      <p>{skill.firstExercise}</p>
                    </div>
                    <div class="skill-tools" aria-label="Tools">
                      {skill.tools.map((tool) => <span>{tool}</span>)}
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    </>
  ) : (
    <section class="panel panel-wide">
      <div class="label">learning unavailable</div>
      <p class="state-entry">Could not read {curriculumPath}: {loadError}</p>
    </section>
  )}

  <style>
    .learning-hero {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 32px;
      margin-bottom: 10px;
      border-top: 2px solid var(--blue);
    }

    .learning-copy {
      max-width: 760px;
    }

    .learning-copy h1 {
      margin: 0 0 10px;
      color: var(--blue);
      font-size: clamp(1.45rem, 3vw, 2.25rem);
      line-height: 1.05;
    }

    .learning-copy p {
      margin: 0;
      color: var(--text);
      font-size: 0.84rem;
      line-height: 1.55;
    }

    .learning-source {
      margin-top: 12px;
      color: var(--muted);
      font-size: 0.68rem;
      overflow-wrap: anywhere;
    }

    .learning-vitals {
      display: grid;
      grid-template-columns: repeat(3, minmax(72px, 1fr));
      min-width: 280px;
      margin: 0;
      border-left: 1px solid #292929;
    }

    .learning-vitals div {
      padding-left: 16px;
    }

    .learning-vitals dt {
      color: var(--muted);
      font-size: 0.64rem;
      text-transform: uppercase;
    }

    .learning-vitals dd {
      margin: 5px 0 0;
      color: var(--text);
      font-size: 1.55rem;
      font-weight: 700;
      line-height: 1;
    }

    .learning-vitals .vital-active {
      color: var(--blue);
    }

    .learning-vitals .vital-complete {
      color: var(--green);
    }

    .learning-phases {
      display: grid;
      gap: 10px;
    }

    .learning-phase {
      display: grid;
      grid-template-columns: minmax(230px, 0.7fr) minmax(0, 1.8fr);
      gap: 22px;
    }

    .learning-phase-head {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-content: start;
      gap: 12px;
    }

    .learning-phase-index {
      color: #333;
      font-size: 1.3rem;
      font-weight: 700;
      line-height: 1;
    }

    .learning-phase-head .label {
      margin-bottom: 4px;
    }

    .learning-phase-head h2 {
      margin: 0 0 8px;
      color: var(--text);
      font-size: 1rem;
      line-height: 1.1;
      text-transform: uppercase;
    }

    .learning-phase-head p {
      margin: 0;
      color: var(--muted);
      font-size: 0.73rem;
      line-height: 1.5;
    }

    .learning-skill-list {
      min-width: 0;
    }

    .learning-skill {
      border-top: 1px solid #272727;
    }

    .learning-skill:last-child {
      border-bottom: 1px solid #272727;
    }

    .learning-skill summary {
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr) auto 12px;
      align-items: center;
      gap: 9px;
      min-height: 42px;
      cursor: pointer;
      list-style: none;
    }

    .learning-skill summary::-webkit-details-marker {
      display: none;
    }

    .learning-skill summary:hover .skill-name,
    .learning-skill summary:focus-visible .skill-name {
      color: var(--blue);
    }

    .skill-priority {
      color: #555;
      font-size: 0.67rem;
    }

    .skill-name {
      color: var(--text);
      font-size: 0.78rem;
      line-height: 1.3;
    }

    .skill-chevron {
      color: #555;
      font-size: 0.65rem;
      transition: transform 120ms ease;
    }

    .learning-skill[open] .skill-chevron {
      transform: rotate(180deg);
    }

    .badge-blue {
      color: var(--blue);
    }

    .skill-body {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 13px;
      padding: 2px 21px 15px 37px;
    }

    .skill-field > span {
      color: #666;
      font-size: 0.61rem;
      text-transform: uppercase;
    }

    .skill-field p {
      margin: 4px 0 0;
      color: var(--muted);
      font-size: 0.69rem;
      line-height: 1.5;
    }

    .skill-tools {
      display: flex;
      flex-wrap: wrap;
      grid-column: 1 / -1;
      gap: 5px;
    }

    .skill-tools span {
      padding: 3px 6px;
      background: #191919;
      color: #aaa;
      font-size: 0.62rem;
    }

    @media (max-width: 800px) {
      .learning-hero {
        align-items: stretch;
        flex-direction: column;
      }

      .learning-vitals {
        min-width: 0;
        padding-top: 12px;
        border-top: 1px solid #292929;
        border-left: 0;
      }

      .learning-vitals div:first-child {
        padding-left: 0;
      }

      .learning-phase {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 560px) {
      .learning-skill summary {
        grid-template-columns: 24px minmax(0, 1fr) auto;
      }

      .skill-chevron {
        display: none;
      }

      .skill-body {
        grid-template-columns: 1fr;
        padding-left: 33px;
      }
    }
  </style>
</AppLayout>
