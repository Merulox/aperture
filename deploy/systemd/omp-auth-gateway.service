[Unit]
Description=OMP shadow credential-indirection gateway
After=network-online.target omp-auth-broker.service
Requires=omp-auth-broker.service
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/merulox
ExecStartPre=/run/current-system/sw/bin/mkdir -p /home/merulox/.local/share/aperture/omp-gateway
ExecStartPre=-/run/current-system/sw/bin/podman rm -f aperture-omp-gateway
ExecStart=/run/current-system/sw/bin/bash -lc 'export OMP_AUTH_BROKER_URL=http://10.89.1.2:49556 OMP_AUTH_BROKER_TOKEN="$(< /home/merulox/.local/share/aperture/omp-broker/auth-broker.token)"; exec /run/current-system/sw/bin/podman run --name aperture-omp-gateway --network podman --network aperture-omp-control:ip=10.89.1.3 --network aperture-omp-shadow:ip=10.89.0.2 -v /home/merulox/projects/aperture/deploy/systemd/omp-gateway-resolv.conf:/etc/resolv.conf:ro --read-only --cap-drop=all --security-opt=no-new-privileges --tmpfs /tmp:rw,nosuid,nodev,size=64m -v /home/merulox/.local/bin/omp:/usr/local/bin/omp:ro -v /home/merulox/.local/share/aperture/omp-gateway:/root/.omp:rw -v /home/merulox/.omp/natives/17.0.5/pi_natives.linux-x64-modern.node:/root/.omp/natives/17.0.5/pi_natives.linux-x64-modern.node:ro --env OMP_AUTH_BROKER_URL --env OMP_AUTH_BROKER_TOKEN docker.io/library/archlinux@sha256:1f83ba0580a15cd6ad1d02d62ad432ddc940f53f07d0e39c8982d6c9c74e53e0 /usr/local/bin/omp auth-gateway serve --no-auth --bind=0.0.0.0:49555'
ExecStop=-/run/current-system/sw/bin/podman stop --time 10 aperture-omp-gateway
ExecStopPost=-/run/current-system/sw/bin/podman rm -f aperture-omp-gateway
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
